<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CashFlowy - Smart Expense Manager</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

    <header class="navbar">
        <div class="logo">
            <span>💰</span> CashFlowy
        </div>

        <nav>
            <a href="#dashboard">Dashboard</a>
            <a href="#transactions">Transactions</a>
            <a href="#analytics">Analytics</a>
        </nav>

        <button class="theme-btn" onclick="toggleTheme()">🌙</button>
    </header>

    <main>

        <!-- Hero -->
        <section class="hero">
            <div>
                <p class="small-title">SMART MONEY MANAGEMENT</p>
                <h1>Manage Your Money<br><span>Smarter & Easier.</span></h1>
                <p>
                    Track your income, control expenses and understand
                    your spending habits with CashFlowy.
                </p>
                <a href="#dashboard" class="hero-btn">Get Started →</a>
            </div>

            <div class="hero-card">
                <div class="card-icon">💳</div>
                <h3>Total Balance</h3>
                <h2 id="heroBalance">₹0</h2>

                <div class="mini-stats">
                    <div>
                        <small>Income</small>
                        <b id="heroIncome">₹0</b>
                    </div>

                    <div>
                        <small>Expense</small>
                        <b id="heroExpense">₹0</b>
                    </div>
                </div>
            </div>
        </section>


        <!-- Dashboard -->
        <section id="dashboard" class="section">

            <div class="section-heading">
                <div>
                    <p class="small-title">OVERVIEW</p>
                    <h2>Financial Dashboard</h2>
                </div>
            </div>

            <div class="stats-grid">

                <div class="stat-card balance">
                    <div class="stat-top">
                        <span>💰</span>
                        <small>Current Balance</small>
                    </div>
                    <h2 id="balance">₹0</h2>
                    <p>Your available balance</p>
                </div>

                <div class="stat-card income">
                    <div class="stat-top">
                        <span>📈</span>
                        <small>Total Income</small>
                    </div>
                    <h2 id="income">₹0</h2>
                    <p>Money received</p>
                </div>

                <div class="stat-card expense">
                    <div class="stat-top">
                        <span>📉</span>
                        <small>Total Expense</small>
                    </div>
                    <h2 id="expense">₹0</h2>
                    <p>Money spent</p>
                </div>

                <div class="stat-card saving">
                    <div class="stat-top">
                        <span>🎯</span>
                        <small>Savings Rate</small>
                    </div>
                    <h2 id="savingRate">0%</h2>
                    <p>Income saved</p>
                </div>

            </div>
        </section>


        <!-- Add Transaction -->
        <section class="section transaction-section">

            <div class="form-container">

                <div class="form-info">
                    <p class="small-title">ADD TRANSACTION</p>
                    <h2>Record Your Money</h2>
                    <p>
                        Add your income or expense and keep your
                        financial records organized.
                    </p>

                    <div class="tips">
                        <div>✓ Track daily expenses</div>
                        <div>✓ Categorize spending</div>
                        <div>✓ Monitor your balance</div>
                        <div>✓ Understand your habits</div>
                    </div>
                </div>

                <form id="transactionForm">

                    <label>Transaction Type</label>

                    <div class="type-buttons">
                        <button type="button"
                            class="type-btn active"
                            data-type="expense">
                            📉 Expense
                        </button>

                        <button type="button"
                            class="type-btn"
                            data-type="income">
                            📈 Income
                        </button>
                    </div>

                    <input type="hidden" id="type" value="expense">

                    <label for="amount">Amount</label>
                    <input
                        type="number"
                        id="amount"
                        placeholder="₹ Enter amount"
                        min="1"
                        required
                    >

                    <label for="category">Category</label>

                    <select id="category" required>
                        <option value="">Select category</option>
                        <option>Food</option>
                        <option>Shopping</option>
                        <option>Transport</option>
                        <option>Bills</option>
                        <option>Entertainment</option>
                        <option>Education</option>
                        <option>Health</option>
                        <option>Salary</option>
                        <option>Business</option>
                        <option>Other</option>
                    </select>

                    <label for="description">Description</label>

                    <input
                        type="text"
                        id="description"
                        placeholder="e.g. Grocery shopping"
                        required
                    >

                    <label for="date">Date</label>

                    <input
                        type="date"
                        id="date"
                        required
                    >

                    <button class="submit-btn" type="submit">
                        + Add Transaction
                    </button>

                </form>

            </div>
        </section>


        <!-- Transactions -->
        <section id="transactions" class="section">

            <div class="section-heading">
                <div>
                    <p class="small-title">HISTORY</p>
                    <h2>Recent Transactions</h2>
                </div>

                <button class="clear-btn" onclick="clearTransactions()">
                    Clear All
                </button>
            </div>

            <div id="transactionList" class="transaction-list">
                <div class="empty">
                    No transactions yet.
                </div>
            </div>

        </section>


        <!-- Analytics -->
        <section id="analytics" class="section">

            <div class="section-heading">
                <div>
                    <p class="small-title">ANALYTICS</p>
                    <h2>Spending Summary</h2>
                </div>
            </div>

            <div class="analytics-card">

                <div class="progress-info">
                    <span>Expense vs Income</span>
                    <strong id="percentage">0%</strong>
                </div>

                <div class="progress-bar">
                    <div id="progress"></div>
                </div>

                <div id="categorySummary" class="category-summary">
                    No spending data available.
                </div>

            </div>

        </section>

    </main>


    <footer>
        <div class="footer-logo">💰 CashFlowy</div>

        <p>
            Smart Expense Manager — Make every rupee count.
        </p>

        <p class="copyright">
            © 2026 CashFlowy. All Rights Reserved.
        </p>
    </footer>


    <script src="script.js"></script>

</body>
</html>